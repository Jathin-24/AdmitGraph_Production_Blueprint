DATABASE_URL=postgresql+asyncpg://admitgraph:admitgraph_dev_password@localhost:5432/admitgraph
REDIS_URL=redis://localhost:6379/0
SERPAPI_API_KEY=replace_me
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth ---
# JWT_SECRET signs every session token. Compose refuses to start without it
# (deployment/docker-compose.yml: ${JWT_SECRET:?...}), and APP_ENV=production
# also refuses this example placeholder and any secret shorter than 32 chars.
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-long-random-string
JWT_TTL_SECONDS=604800
ADMIN_EMAILS=

# Frontend origin used to build links in outgoing emails (welcome, research,
# monitor alerts, password reset / email verification). Must be the URL users
# actually open — never localhost outside local development.
FRONTEND_URL=http://localhost:3000

# --- Mail (EMAIL_ENABLED=false writes messages to the local file outbox) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=AdmitGraph <no-reply@admitgraph.local>

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
MONITOR_MAX_CHECKS_PER_TICK=5

# --- SerpApi reliability ---
SERPAPI_CACHE_TTL_SECONDS=21600
SERPAPI_MAX_CONCURRENCY=3
SERPAPI_CIRCUIT_THRESHOLD=5
